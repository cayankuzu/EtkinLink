{
  "name": "etkinlink-workspace",
  "version": "0.1.5",
  "private": true,
  "scripts": {
    "start": "npm --prefix mobile run start --",
    "start:clear": "npm --prefix mobile run start:clear --",
    "android": "npm --prefix mobile run android",
    "typecheck": "npm --prefix mobile run typecheck",
    "lint": "npm --prefix mobile run lint",
    "test": "npm --prefix mobile run test",
    "verify": "npm run feature-freeze && npm run release:evidence:test && npm --prefix mobile run verify",
    "feature-freeze": "node scripts/guards/check-no-new-product-surface.mjs",
    "release:evidence:test": "node --test scripts/release/generate-evidence-manifest.test.mjs mobile/scripts/check-github-release-evidence.test.mjs",
    "docker:config": "node --test infra/docker/scripts/_common.test.mjs && node infra/docker/scripts/validate-compose.mjs",
    "docker:up:test": "node infra/docker/scripts/run-test-profile.mjs --up-only",
    "docker:test": "node infra/docker/scripts/run-test-profile.mjs",
    "docker:resilience": "node infra/docker/scripts/run-resilience-profile.mjs",
    "docker:load": "node infra/docker/scripts/run-load-profile.mjs",
    "docker:down": "node infra/docker/scripts/cleanup.mjs down",
    "docker:clean": "node infra/docker/scripts/cleanup.mjs clean",
    "build:debug": "npm --prefix mobile run build:debug",
    "doctor": "npm --prefix mobile run doctor"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "devDependencies": {
    "etkinlink-expo-root-proxy": "file:tools/expo-root-proxy"
  }
}
