{
  "name": "@etkinlink/cloudflare-edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "test": "vitest run",
    "types": "wrangler types worker-configuration.d.ts --env-file .dev.vars.example",
    "types:check": "wrangler types worker-configuration.d.ts --env-file .dev.vars.example --check",
    "check": "npm run types:check && npm run typecheck && npm run lint && npm run format && npm test",
    "dry-run:development": "wrangler deploy --env development --dry-run --outdir dist/development",
    "dry-run:preview": "wrangler deploy --env preview --dry-run --outdir dist/preview",
    "dry-run:production": "wrangler deploy --env production --dry-run --outdir dist/production",
    "dry-run": "npm run dry-run:development && npm run dry-run:preview && npm run dry-run:production"
  },
  "dependencies": {
    "jose": "6.2.10",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.2",
    "@eslint/js": "10.0.1",
    "@msw/cloudflare": "0.0.1",
    "eslint": "10.9.1",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
