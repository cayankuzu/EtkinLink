# These values are intentionally public and are the only Supabase values allowed in the app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional selective event gateway. Keep auth/database/storage/realtime on Supabase.
# Must be a bare HTTPS origin, for example https://api.example.com (no path/query).
EDGE_API_BASE_URL=

# Optional operational integrations. Never commit real values.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
