{
  "name": "etkinlink-mobile",
  "version": "0.0.6",
  "private": true,
  "scripts": {
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-expo-debug.ps1 -Install",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"*.{js,json,md}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"*.{js,json,md}\"",
    "architecture": "depcruise src --config .dependency-cruiser.cjs",
    "audit:production": "node ./scripts/audit-production.cjs",
    "security:guards": "node ./scripts/check-security-guards.mjs",
    "compatibility:guards": "node ./scripts/check-device-compatibility.mjs",
    "performance:guards": "node ./scripts/check-performance-budgets.mjs",
    "accessibility:guards": "node ./scripts/check-accessibility-guards.mjs",
    "touch-target:guards": "node ./scripts/check-touch-targets.mjs",
    "screen-state:matrix": "node ./scripts/build-screen-state-matrix.mjs",
    "screen-state:guards": "node ./scripts/build-screen-state-matrix.mjs --check",
    "touch-target:guards:test": "node --test ./scripts/check-touch-targets.test.mjs",
    "contrast:guards": "node ./scripts/check-contrast.mjs",
    "accessibility:guards:test": "node --test ./scripts/check-accessibility-guards.test.mjs",
    "hardcode:guards": "node ./scripts/check-hardcoded-values.mjs",
    "hardcode:guards:test": "node --test ./scripts/check-hardcoded-values.test.mjs",
    "critical-flows": "node ./scripts/check-critical-flow-evidence.mjs",
    "e2e:staging-backend": "node ./scripts/staging-critical-e2e.mjs",
    "release:check": "node ./scripts/check-release-readiness.mjs",
    "release:signer:verify": "node ./scripts/verify-release-signer-identity.mjs",
    "release:signer:test": "node --test ./scripts/verify-release-signer-identity.test.mjs",
    "ota:classify": "node ./scripts/classify-update.mjs",
    "ota:classifier:test": "node --test ./scripts/classify-update.test.mjs",
    "release:evidence": "node ./scripts/check-github-release-evidence.mjs",
    "sentry:verify-release": "node ./scripts/verify-sentry-release.mjs",
    "sentry:configure-alerts": "node ./scripts/configure-sentry-alerts.mjs",
    "sentry:check-health": "node ./scripts/check-sentry-release-health.mjs",
    "deadcode": "knip",
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "coverage:ratchet": "node ./scripts/check-coverage-ratchet.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run architecture && npm run deadcode && npm run security:guards && npm run compatibility:guards && npm run performance:guards && npm run accessibility:guards && npm run accessibility:guards:test && npm run contrast:guards && npm run touch-target:guards && npm run touch-target:guards:test && npm run screen-state:guards && npm run hardcode:guards && npm run hardcode:guards:test && npm run critical-flows && npm run ota:classifier:test && npm run release:signer:test && npm run test",
    "build:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-expo-debug.ps1",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "^2.3.2",
    "@supabase/supabase-js": "^2.112.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "babel-preset-expo": "~57.0.0",
    "base64-arraybuffer": "^1.0.2",
    "date-fns": "^4.4.0",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "fast-xml-parser": "^5.10.1",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-hook-form": "^7.84.0",
    "react-native": "0.86.3",
    "react-native-config": "^1.6.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.10.1",
    "uuid": "^14.0.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^8.19.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fast-check": "^4.9.0",
    "jest": "^29.6.3",
    "knip": "^6.31.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "overrides": {
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "nanoid": "3.3.18",
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "packageManager": "npm@11.17.0"
}
