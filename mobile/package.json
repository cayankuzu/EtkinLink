{
  "name": "etkinlink-mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-expo-debug.ps1 -Install",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"*.{js,json,md}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"*.{js,json,md}\"",
    "architecture": "depcruise src --config .dependency-cruiser.cjs",
    "deadcode": "knip",
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run architecture && npm run deadcode && npm run test",
    "build:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-expo-debug.ps1",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@shopify/flash-list": "^2.3.2",
    "@supabase/supabase-js": "^2.112.1",
    "@tanstack/react-query": "^5.101.4",
    "babel-preset-expo": "~57.0.0",
    "base64-arraybuffer": "^1.0.2",
    "date-fns": "^4.4.0",
    "expo": "^57.0.11",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-media-library": "~57.0.3",
    "expo-splash-screen": "~57.0.5",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.12",
    "fast-xml-parser": "^5.10.1",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-hook-form": "^7.84.0",
    "react-native": "0.86.2",
    "react-native-config": "^1.6.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.10.1",
    "uuid": "^14.0.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^8.19.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fast-check": "^4.9.0",
    "jest": "^29.6.3",
    "knip": "^6.31.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "packageManager": "npm@11.17.0"
}
